# Google OAuth Client ID (optional, from Google Cloud Console -> APIs & Services -> Credentials)
# If left empty, Calorie Runner uses the built-in instant one-click Google Sign-in selector.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Telegram Bot Integration (get token from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_APP_URL=https://rush-calory.vercel.app

# Google Gemini API (for AI Food Vision Scanner, get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
